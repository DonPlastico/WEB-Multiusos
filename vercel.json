{
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!_vercel/|locales/|img/|assets/|manifest\\.json|robots\\.txt|favicon).*)",
      "destination": "/"
    }
  ]
}
